<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later, dark mode: the mark on slate. This file is
         needed as well as values-v31, because Android ranks night above the
         version, and would otherwise take values-night and lose the splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/slate</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/slate</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/slate</item>
    </style>
</resources>

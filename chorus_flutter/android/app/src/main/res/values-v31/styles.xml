<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own launch screen: the mark on card,
         light mode. The icon has no background of its own, so the system
         shows it at 288 dp with the mark inside the central 192 dp circle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/card</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/card</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/card</item>
    </style>
</resources>

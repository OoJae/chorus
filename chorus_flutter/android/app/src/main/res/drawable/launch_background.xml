<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the mark on the page colour (card, or
     slate in dark mode), until Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
